# Minakata 環境変数のテンプレート。`cp .env.example .env` で複製して値を埋める。
# !! 実値はコミットしない !! (.gitignore で .env を除外済み)

# Minakata MCP サーバーの Bearer Token(Hermes が接続するために共有)
# 生成例: `openssl rand -hex 32`
MCP_TOKEN=

# SQLite ファイルパス(コンテナ内のパス)
DATABASE_URL=file:/app/data/minakata.db

# Transformers.js のモデルキャッシュ先(`tech-stack.md` §5.1)
HF_HOME=/app/.cache/huggingface

# セッション Cookie の `Secure` 属性。HTTPS 経由(Caddy reverse proxy 等)では
# `true` のままに。ローカル開発で HTTP のままアクセスする場合のみ `false` に
# する。未指定 = true(本番デフォルト)。
COOKIE_SECURE=true

# --- Hermes コンテナ専用(Minakata 側からは見えてはいけない) ---

# Hermes コンテナ内 hermes user の UID / GID。podman rootless では UID
# マッピングを揃えないと /opt/data の chown が無視されて skills_sync.py が
# PermissionError で落ちる(#42)。下記のように現在のシェルで展開してから
# .env に書く(これらは数値リテラルしか受け付けない):
#   echo "HERMES_UID=$(id -u)" >> .env
#   echo "HERMES_GID=$(id -g)" >> .env
HERMES_UID=10000
HERMES_GID=10000

# OpenCode API キー(opencode.ai/auth で取得)。Go / Zen どちらも同じキーで叩ける。
# Hermes コンテナ内では OPENCODE_GO_API_KEY という別名で渡され、
# opencode-go プロバイダ(base_url ハードコード)に紐付く(#44)。
OPENCODE_API_KEY=

# Firecrawl API キー(Web 抽出)
FIRECRAWL_API_KEY=

# SearXNG セッションシークレット(`openssl rand -hex 32`)
SEARXNG_SECRET=
