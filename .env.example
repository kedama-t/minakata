# Minakata 環境変数のテンプレート。`cp .env.example .env` で複製して値を埋める。
# !! 実値はコミットしない !! (.gitignore で .env を除外済み)

# Minakata MCP サーバーの Bearer Token(Hermes が接続するために共有)
# 生成例: `openssl rand -hex 32`
MCP_TOKEN=

# SQLite ファイルパス(コンテナ内のパス)
DATABASE_URL=file:/app/data/minakata.db

# Transformers.js のモデルキャッシュ先(`tech-stack.md` §5.1)
HF_HOME=/app/.cache/huggingface

# セッション Cookie の `Secure` 属性。HTTPS 経由(Caddy reverse proxy 等)では
# `true` のままに。ローカル開発で HTTP のままアクセスする場合のみ `false` に
# する。未指定 = true(本番デフォルト)。
COOKIE_SECURE=true

# 日時表示のタイムゾーン(IANA タイムゾーン名)。未指定 = Asia/Tokyo
TIMEZONE=Asia/Tokyo

# --- 定期バックアップ(backup_agent が日次で minakata.backup を呼ぶ) ---
# 記事・DB・runtime skills を専用 git repo(既定 data/backup)に集約し、下記の
# remote が設定されていれば GitHub private repo へ push する。未設定ならローカル
# commit のみ(オフサイト保護なし)。
#
# push 先 private repo の HTTPS URL(例: https://github.com/owner/minakata-backup.git)
BACKUP_GIT_REMOTE=
# 上記 repo への書き込み用 fine-grained PAT。対象 repo の contents:write のみ付与。
# remote URL に x-access-token として注入される。実値はコミットしない。
BACKUP_GIT_TOKEN=

# --- Hermes コンテナ専用(Minakata 側からは見えてはいけない) ---

# Hermes コンテナ内 hermes user の UID / GID。podman rootless では UID
# マッピングを揃えないと /opt/data の chown が無視されて skills_sync.py が
# PermissionError で落ちる(#42)。下記のように現在のシェルで展開してから
# .env に書く(これらは数値リテラルしか受け付けない):
#   echo "HERMES_UID=$(id -u)" >> .env
#   echo "HERMES_GID=$(id -g)" >> .env
HERMES_UID=10000
HERMES_GID=10000

# skill の初期化(#187)。skill の正本は git 管理の hermes-skills/ にあり、
# 起動時に実行時 hermes/skills/ へ seed される。既定は「無い skill だけ」
# コピーして Hermes curator の進化版を維持する。1 にすると起動時に実行時
# skill を正本(初期状態)で強制上書きする(リセット弁)。普段は未設定でよい。
# MINAKATA_SKILLS_RESET=1

# OpenCode API キー(opencode.ai/auth で取得)。Go / Zen どちらも同じキーで叩ける。
# Hermes コンテナ内では OPENCODE_GO_API_KEY という別名で渡され、
# opencode-go プロバイダ(base_url ハードコード)に紐付く(#44)。
OPENCODE_API_KEY=

# Firecrawl API キー(Web 抽出)
FIRECRAWL_API_KEY=

# Firecrawl の baseUrl。Minakata の互換エンドポイントを使うため既定は
# http://minakata:3000。外部 Firecrawl を使う場合のみ変更する。
FIRECRAWL_BASE_URL=http://minakata:3000

# SearXNG セッションシークレット(`openssl rand -hex 32`)
SEARXNG_SECRET=
