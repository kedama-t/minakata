# `../hermes` を `/opt/data` に bind mount しているので、Hermes が生成・
# 更新する大量の runtime state がここに展開される(#52)。git track したい
# のは下記だけ:
#   - .gitignore
#   - config.yaml (Hermes が re-write することもあるが canonical 源を保持)
#   - cron-bootstrap.sh
# それ以外は基本全部 ignore。
#
# skill の初期状態の正本はリポジトリ直下 `hermes-skills/` で git 管理し、
# 起動時に cron-bootstrap.sh が `/opt/data/skills/` へ seed する(#187)。
# 実行時 skill は Hermes が curator で自律編集するため git からは完全に除外。

# --- skills: 実行時コピーは全て ignore(正本は ../hermes-skills) ---
/skills/

# --- Hermes 生成のディレクトリ ---
/.cache/
/.hermes/
/.local/
/audio_cache/
/bin/
/cache/
/cron/
/home/
/hooks/
/image_cache/
/logs/
/memories/
/pairing/
/pastes/
/plans/
/profiles/
/sandboxes/
/sessions/
/skins/
/workspace/
/.hub/

# --- Hermes が seed / 書き込む単発ファイル ---
/.env
/.hermes_history
/.install_method
/.container-mode
/.managed
/.update_check
/active_profile
/auth.json
/auth.lock
/config.yaml.bak
/interrupt_debug.log
/models_dev_cache.json
/ollama_cloud_models_cache.json
/SOUL.md
/state.db
/state.db-*
/.skills_prompt_snapshot.json
/channel_directory.json
/gateway.lock
/gateway.pid
/gateway_state.json
/kanban.db
/kanban.db-*

# --- gateway HERMES_HOME=/opt/data 修正前に作られた退避ディレクトリ ---
/.hermes.bak.*/

# --- Hermes が investigation 中に作る debug script ---
/_check_*.py

/.clean_shutdown